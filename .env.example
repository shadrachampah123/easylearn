# Neon database connection string
# Get yours from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-late-sun-ay0s8o6c-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT secret for authentication (must be at least 32 characters)
JWT_SECRET="your-jwt-secret-must-be-at-least-32-characters-long"

# Optional stock image search for quiz questions. If omitted, the app uses the no-key Openverse fallback.
UNSPLASH_ACCESS_KEY=""

# Optional: where uploaded assignment/submission files are stored on disk.
# Defaults to ./storage/uploads (git-ignored). On ephemeral hosts, point this at
# a mounted volume so uploads survive redeploys.
# UPLOAD_DIR="/var/data/easylearn/uploads"

# ── Cloud object storage (optional, recommended for Vercel) ──
# When these are set, teachers and learners upload files (up to 100 MB videos)
# DIRECTLY to the bucket via presigned URLs, bypassing Vercel's ~4.5 MB request
# body limit. Downloads also redirect to presigned URLs, so the bucket can stay
# fully private. Leave unset to keep storing files on local disk.
#
# AWS S3:
#   OBJECT_STORAGE_BUCKET="easylearn-files"
#   OBJECT_STORAGE_REGION="us-east-1"
#   OBJECT_STORAGE_ACCESS_KEY_ID="AKIA..."
#   OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
#
# Cloudflare R2 (endpoint = your R2 account S3 endpoint):
#   OBJECT_STORAGE_BUCKET="easylearn-files"
#   OBJECT_STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   OBJECT_STORAGE_REGION="auto"
#   OBJECT_STORAGE_ACCESS_KEY_ID="..."
#   OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
#
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
#
# Optional tuning:
# OBJECT_STORAGE_FORCE_PATH_STYLE="true"      # default: true when ENDPOINT is set (R2/MinIO)
# OBJECT_STORAGE_PUBLIC_URL=""                # public base URL for a public-read bucket
# OBJECT_STORAGE_UPLOAD_EXPIRY="900"          # presigned PUT lifetime (seconds)
# OBJECT_STORAGE_DOWNLOAD_EXPIRY="3600"       # presigned GET lifetime (seconds)
#
# IMPORTANT: configure CORS on the bucket so the browser can PUT directly to it:
#   AllowedOrigins: your app origin (e.g. https://your-app.vercel.app)
#   AllowedMethods: PUT, GET, HEAD, DELETE
#   AllowedHeaders: content-type
#   ExposeHeaders: ETag
