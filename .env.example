# Neon database connection string
# Get yours from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-late-sun-ay0s8o6c-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── JWT secret for authentication ────────────────────────────────────────────────
# This value signs and verifies every session token. Anyone who knows it can mint a
# token for any user in any school, so it must be a random value that only this
# deployment knows.
#
# Generate one (48 random bytes -> 64 base64 characters):
#     openssl rand -base64 48
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# The application REFUSES to sign or verify a token with a secret that is missing,
# shorter than 32 characters, a well-known placeholder, or built from a repeating
# pattern. See docs/SECURITY_AUTHENTICATION.md for the full policy.
#
# ROTATION: changing this value invalidates every existing session immediately
# (all users are signed out). Rotate by setting the new value and redeploying; there
# is no overlap window, because the app holds exactly one signing key.
#
# JWT_SECRET="<paste the output of `openssl rand -base64 48` here>"
JWT_SECRET=""

# ── Additional origins allowed to make state-changing API requests ─────────────
# Optional, comma-separated, empty by default. An empty list means "same origin
# only", which is what you want.
#
# A state-changing request is refused with 403 unless it comes from this
# application's own origin. Add an entry ONLY if a separate, trusted origin has
# to make state-changing calls (for example a first-party service on another
# host). Each entry is a full trust decision: anything running on that origin
# can make state-changing requests with the session cookie.
#
# EASY_LEARN_ALLOWED_ORIGINS="https://admin.example.com"
EASY_LEARN_ALLOWED_ORIGINS=""

# ── The public origin of this deployment ───────────────────────────────────────
# The scheme and host the browser uses to reach this application, e.g.
# "https://easylearn.example.com". A state-changing request is compared
# against this origin.
#
# SET THIS when the application runs behind a reverse proxy, a CDN or a
# platform edge. It is the recommended configuration for any such deployment,
# because it removes every question about what the edge does with the headers
# it forwards.
#
# Leave it EMPTY only for a direct deployment, where the `Host` header is
# already the public host. If the edge REWRITES the `Host` header to an
# internal name and this variable is empty, every state-changing request is
# refused with 403 — a safe failure, but an outage.
#
# EASY_LEARN_PUBLIC_ORIGIN="https://easylearn.example.com"
EASY_LEARN_PUBLIC_ORIGIN=""

# ── Trusting the forwarded headers (advanced; normally leave it OFF) ───────────
# The application cannot tell a client-supplied `X-Forwarded-Host` from one the
# edge set: a proxy may APPEND to a client-supplied value, and an edge that
# does not set the header leaves the client's value in place. That is why the
# forwarded headers are NOT trusted by default — the origin is derived from the
# `Host` header instead.
#
# Turn this on ONLY if the edge in front of this application is known to
# OVERWRITE (never append to) both `X-Forwarded-Host` and `X-Forwarded-Proto`.
# With it on:
#   - a single-valued `X-Forwarded-Host` becomes a candidate origin;
#   - a MULTI-VALUED `X-Forwarded-Host` is distrusted entirely, because the
#     first element of it is the one a client controls;
#   - `https` is also a candidate scheme, because a TLS-terminating edge
#     leaves the last hop in plain HTTP.
#
# `EASY_LEARN_PUBLIC_ORIGIN` takes precedence over this setting.
#
# EASY_LEARN_TRUST_PROXY_HEADERS="true"
EASY_LEARN_TRUST_PROXY_HEADERS=""

# Optional stock image search for quiz questions. If omitted, the app uses the no-key Openverse fallback.
UNSPLASH_ACCESS_KEY=""

# Optional: where uploaded assignment/submission files are stored on disk.
# Defaults to ./storage/uploads (git-ignored). On ephemeral hosts, point this at
# a mounted volume so uploads survive redeploys.
# UPLOAD_DIR="/var/data/easylearn/uploads"

# ── Cloud object storage (optional, recommended for Vercel) ──
# When these are set, teachers and learners upload files (up to 100 MB videos)
# DIRECTLY to the bucket via presigned URLs, bypassing Vercel's ~4.5 MB request
# body limit. Downloads also redirect to presigned URLs, so the bucket can stay
# fully private. Leave unset to keep storing files on local disk.
#
# AWS S3:
#   OBJECT_STORAGE_BUCKET="easylearn-files"
#   OBJECT_STORAGE_REGION="us-east-1"
#   OBJECT_STORAGE_ACCESS_KEY_ID="AKIA..."
#   OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
#
# Cloudflare R2 (endpoint = your R2 account S3 endpoint):
#   OBJECT_STORAGE_BUCKET="easylearn-files"
#   OBJECT_STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   OBJECT_STORAGE_REGION="auto"
#   OBJECT_STORAGE_ACCESS_KEY_ID="..."
#   OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
#
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
#
# Optional tuning:
# OBJECT_STORAGE_FORCE_PATH_STYLE="true"      # default: true when ENDPOINT is set (R2/MinIO)
# OBJECT_STORAGE_PUBLIC_URL=""                # public base URL for a public-read bucket
# OBJECT_STORAGE_UPLOAD_EXPIRY="900"          # presigned PUT lifetime (seconds)
# OBJECT_STORAGE_DOWNLOAD_EXPIRY="3600"       # presigned GET lifetime (seconds)
#
# IMPORTANT: configure CORS on the bucket so the browser can PUT directly to it:
#   AllowedOrigins: your app origin (e.g. https://your-app.vercel.app)
#   AllowedMethods: PUT, GET, HEAD, DELETE
#   AllowedHeaders: content-type
#   ExposeHeaders: ETag
