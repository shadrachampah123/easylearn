@@ -0,0 +1,102 @@
+/** Supplemental credential edge cases absent from the committed PR #45 suite. */
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { NextRequest } from "next/server";
+import { getTokenFromRequest } from "@/lib/auth";
+import { hasSessionCookie, readSessionCookie } from "@/lib/session-cookie";
+import { evaluateCsrfRequestForRequest } from "@/lib/csrf";
+import proxy from "@/proxy";
+
+const origin = "https://review.example.test";
+const foreign = "https://other.example.test";
+function request(headers: Record<string,string> = {}, method = "POST") {
+  return new NextRequest(`${origin}/api/quizzes`,{method,headers:{host:"review.example.test",...headers}});
+}
+// Tests pin the default policy without altering any deployment configuration.
+for (const name of ["EASY_LEARN_PUBLIC_ORIGIN","EASY_LEARN_ALLOWED_ORIGINS","EASY_LEARN_TRUST_PROXY_HEADERS"]) delete process.env[name];
+
+for (const [label,cookie,selected] of [
+  ["two values; first wins","el_token=first; el_token=second","first"],
+  ["empty first value cannot fall through","el_token=; el_token=second",null],
+  ["malformed percent encoding first cannot fall through","el_token=%ZZ; el_token=second",null],
+  ["malformed last value cannot shadow the first","el_token=first; el_token=%ZZ","first"],
+  ["empty cookie","el_token=",null],
+  ["encoded cookie","theme=dark; el_token=first%2Esecond","first.second"],
+] as const) {
+  test(`cookie ambiguity: ${label}`,async()=>{
+    assert.equal(readSessionCookie(cookie),selected);
+    assert.equal(hasSessionCookie(cookie),true);
+    const req=request({cookie,authorization:"Bearer explicit",origin:foreign});
+    assert.equal(getTokenFromRequest(req),"explicit");
+    assert.equal(evaluateCsrfRequestForRequest(req).allowed,false);
+    const response=proxy(req);
+    assert.equal(response.status,403);
+    assert.equal(response.headers.get("cache-control"),"no-store");
+    const payload=await response.text();
+    assert.ok(!payload.includes("explicit") && !payload.includes("first%2Esecond"));
+  });
+}
+test("whenever the auth cookie parser selects a token, the CSRF presence parser detects it",()=>{
+  for (const prefix of ["","theme=x;","theme=x; ","theme=x;\t", "other_el_token=z; "])
+    for (const value of ["signed.token.example","","%ZZ","%20","%3B",'"quoted"']) {
+      const cookie=`${prefix}el_token=${value}; other=x`;
+      if (readSessionCookie(cookie)) assert.equal(hasSessionCookie(cookie),true,cookie);
+    }
+  for (const cookie of ["other_el_token=x","el_token_other=x","EL_TOKEN=x","el_token =x","el_token"]) {
+    assert.equal(hasSessionCookie(cookie),false);
+    assert.equal(readSessionCookie(cookie),null);
+  }
+});
+for (const [label,authorization] of [
+  ["lowercase scheme","bearer token"],
+  ["uppercase scheme","BEARER token"],
+  ["tab separator","Bearer\ttoken"],
+  ["empty bearer","Bearer "],
+  ["Basic scheme","Basic token"],
+  ["multiple schemes","Basic x, Bearer token"],
+] as const) {
+  test(`malformed or differently cased Authorization plus cookie: ${label}`,()=>{
+    const req=request({authorization,cookie:"el_token=cookie-identity",origin:foreign});
+    assert.equal(getTokenFromRequest(req),"cookie-identity");
+    assert.equal(evaluateCsrfRequestForRequest(req).allowed,false);
+    assert.equal(proxy(req).status,403);
+  });
+}
+test("parser mismatch is fail-closed for auth: lowercase/tab bearer without cookie selects no credential",()=>{
+  for (const authorization of ["bearer token","BEARER token","Bearer\ttoken"]) {
+    const req=request({authorization});
+    assert.equal(evaluateCsrfRequestForRequest(req).rule,"bearer");
+    assert.equal(getTokenFromRequest(req),null);
+  }
+});
+test("a canonical invalid bearer is selected instead of falling back to the cookie",()=>{
+  const req=request({authorization:"Bearer invalid",cookie:"el_token=cookie-identity",origin});
+  assert.equal(getTokenFromRequest(req),"invalid");
+  assert.equal(evaluateCsrfRequestForRequest(req).rule,"same-origin");
+});
+for (const [fetchSite,allowed] of [["same-origin",true],["none",true],["same-site",false],["cross-site",false],["invalid",false],["",false]] as const) {
+  test(`cookie + bearer with missing Origin and Fetch Metadata=${fetchSite || "absent"}`,()=>{
+    const req=request({cookie:"el_token=ambient",authorization:"Bearer explicit",...(fetchSite ? {"sec-fetch-site":fetchSite} : {})});
+    const decision=evaluateCsrfRequestForRequest(req);
+    assert.equal(decision.allowed,allowed);
+    assert.notEqual(decision.rule,"bearer");
+    assert.equal(proxy(req).status,allowed ? 200 : 403);
+  });
+}
+test("null/foreign Origin is not overridden by a same-origin Fetch Metadata assertion",()=>{
+  for (const hostileOrigin of ["null",foreign,"not an origin"]) {
+    const req=request({cookie:"el_token=ambient",authorization:"Bearer explicit",origin:hostileOrigin,"sec-fetch-site":"same-origin"});
+    assert.equal(evaluateCsrfRequestForRequest(req).allowed,false);
+  }
+});
+test("forged forwarded host/proto cannot bypass cookie + bearer protection in the default mode",()=>{
+  const req=request({cookie:"el_token=ambient",authorization:"Bearer explicit",origin:foreign,"x-forwarded-host":"other.example.test","x-forwarded-proto":"https","sec-fetch-site":"cross-site"});
+  assert.equal(proxy(req).status,403);
+});
+test("configured canonical origin remains exact for cookie + bearer requests",()=>{
+  process.env.EASY_LEARN_PUBLIC_ORIGIN=origin;
+  try {
+    const req=request({cookie:"el_token=ambient",authorization:"Bearer explicit",origin:"http://review.example.test","sec-fetch-site":"same-origin","x-forwarded-host":"review.example.test"});
+    assert.equal(proxy(req).status,403);
+  } finally { delete process.env.EASY_LEARN_PUBLIC_ORIGIN; }
+});
diff --git a/tests/pr45-review-harness.test.cjs b/tests/pr45-review-harness.test.cjs
new file mode 100644
--- /dev/null
+++ b/tests/pr45-review-harness.test.cjs
@@ -0,0 +1,42 @@
+/**
+ * Regression for PR #45's quiz-access test runner swallowing a setup failure.
+ * Fault injection is confined to a child process: only its migration subprocess
+ * reports a controlled error. No application/test source or SQL is replaced.
+ * Requires a disposable localhost server because the original suite creates and drops
+ * its scratch database before/after the injected migration failure.
+ */
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+const { test } = require("node:test");
+
+test("quiz-access runner must exit nonzero when its migrations fail before assertions",()=>{
+  assert.equal(process.env.EASY_LEARN_TEST_DATABASE,"true");
+  const adminUrl=new URL(process.env.TEST_DATABASE_URL);
+  assert.ok(["127.0.0.1","localhost","[::1]"].includes(adminUrl.hostname));
+  const directory=fs.mkdtempSync(path.join(os.tmpdir(),"pr45-harness-review-"));
+  const preload=path.join(directory,"fail-migration.cjs");
+  fs.writeFileSync(preload,`
+    const cp=require('node:child_process');
+    const original=cp.spawnSync;
+    cp.spawnSync=function(command,args,options) {
+      if (Array.isArray(args) && args[0]==='run-migration.js') {
+        return {status:42,stdout:'',stderr:'PR45 controlled migration failure',pid:0,signal:null};
+      }
+      return original.apply(this,arguments);
+    };
+  `);
+  try {
+    const result=spawnSync(process.execPath,["--require",preload,"--import","tsx","tests/quiz-access-db.test.ts"],{
+      cwd:path.resolve(__dirname,".."),env:process.env,encoding:"utf8",timeout:30000,
+    });
+    const output=`${result.stdout || ""}${result.stderr || ""}`;
+    assert.ok(!result.error,result.error?.message);
+    assert.match(output,/PR45 controlled migration failure/);
+    assert.ok(!/quiz access: \d+ passed/.test(output),"no assertions should have executed after failed setup");
+    console.log(`Observed child exit=${result.status} after controlled migration failure; zero test assertions executed.`);
+    assert.notEqual(result.status,0,"setup errors must fail CI, not just print an error and exit 0");
+  } finally { fs.rmSync(directory,{recursive:true,force:true}); }
+});
diff --git a/tests/pr45-review-http.test.cjs b/tests/pr45-review-http.test.cjs
new file mode 100644
--- /dev/null
+++ b/tests/pr45-review-http.test.cjs
@@ -0,0 +1,49 @@
+/** Probe the actual Next production proxy, not just an imported proxy function.
+ * Start the reviewed build locally on port 3015, with a disposable/unused DB URL.
+ * Only invalid synthetic credentials are used: 401 proves the request reached auth;
+ * 403 proves it was rejected by the CSRF proxy before auth.
+ */
+const assert=require('node:assert/strict');
+const http=require('node:http');
+const {test}=require('node:test');
+const localPort=Number(process.env.PR45_REVIEW_PORT || 3015);
+function post(headers={}) {
+  return new Promise((resolve,reject)=>{
+    const req=http.request({host:'127.0.0.1',port:localPort,path:'/api/quizzes',method:'POST',headers:{host:'review.example.test','content-type':'application/json',...headers}},res=>{
+      let body=''; res.setEncoding('utf8'); res.on('data',chunk=>body+=chunk);
+      res.on('end',()=>resolve({status:res.statusCode,headers:res.headers,body}));
+    });
+    req.on('error',reject); req.end('{}');
+  });
+}
+const cookie='el_token=invalid-cookie';
+const bearer='Bearer invalid-bearer';
+for (const [name,headers,status] of [
+  ['foreign cookie+bearer',{cookie,authorization:bearer,origin:'http://foreign.example.test'},403],
+  ['same-origin cookie+bearer',{cookie,authorization:bearer,origin:'http://review.example.test'},401],
+  ['missing metadata cookie+bearer',{cookie,authorization:bearer},403],
+  ['missing Origin cross-site metadata',{cookie,authorization:bearer,'sec-fetch-site':'cross-site'},403],
+  ['missing Origin same-site metadata',{cookie,authorization:bearer,'sec-fetch-site':'same-site'},403],
+  ['missing Origin same-origin metadata',{cookie,authorization:bearer,'sec-fetch-site':'same-origin'},401],
+  ['missing Origin none metadata',{cookie,authorization:bearer,'sec-fetch-site':'none'},401],
+  ['duplicate cookie first empty',{cookie:'el_token=; el_token=second',authorization:bearer,origin:'http://foreign.example.test'},403],
+  ['duplicate Cookie header fields',{cookie:['el_token=%ZZ','el_token=second'],authorization:bearer,origin:'http://foreign.example.test'},403],
+  ['lowercase bearer with cookie',{cookie,authorization:'bearer invalid',origin:'http://foreign.example.test'},403],
+  ['tab-separated bearer with cookie',{cookie,authorization:'Bearer\tinvalid',origin:'http://foreign.example.test'},403],
+  ['empty bearer with cookie',{cookie,authorization:'Bearer ',origin:'http://foreign.example.test'},403],
+  ['canonical bearer only',{authorization:bearer},401],
+  ['lowercase bearer only',{authorization:'bearer invalid'},401],
+  ['tab-separated bearer only',{authorization:'Bearer\tinvalid'},401],
+  ['empty bearer only',{authorization:'Bearer '},403],
+  ['null Origin and claimed same-origin',{cookie,authorization:bearer,origin:'null','sec-fetch-site':'same-origin'},403],
+  ['forged forwarding headers do not change foreign host',{cookie,authorization:bearer,origin:'http://foreign.example.test','x-forwarded-host':'foreign.example.test','x-forwarded-proto':'http'},403],
+  ['derived-scheme legitimate same-origin metadata',{cookie,authorization:bearer,origin:'http://review.example.test','x-forwarded-proto':'https','sec-fetch-site':'same-origin'},401],
+  ['derived-scheme correction not granted to cross-site metadata',{cookie,authorization:bearer,origin:'http://review.example.test','x-forwarded-proto':'https','sec-fetch-site':'cross-site'},403],
+]) {
+  test(`real HTTP: ${name}`,async()=>{
+    const result=await post(headers);
+    assert.equal(result.status,status,result.body);
+    assert.ok(!result.body.includes('invalid-cookie')&&!result.body.includes('invalid-bearer'));
+    if (status===403) assert.equal(result.headers['cache-control'],'no-store');
+  });
+}
diff --git a/tests/pr45-review-mutation.test.cjs b/tests/pr45-review-mutation.test.cjs
new file mode 100644
--- /dev/null
+++ b/tests/pr45-review-mutation.test.cjs
@@ -0,0 +1,47 @@
+/** Ensure the committed M6 mutation removes a guard rather than breaking SQL syntax.
+ * This adds a check; it does not modify the existing mutation harness or assertions.
+ * The SQL uses a temporary table on the explicitly local, disposable test server.
+ */
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const crypto=require('node:crypto');
+const {test}=require('node:test');
+const {Client}=require('pg');
+const ts=require('typescript');
+
+function getM6() {
+  const filename=path.join(__dirname,'tenant-authorization-mutation.test.ts');
+  const source=ts.createSourceFile(filename,fs.readFileSync(filename,'utf8'),ts.ScriptTarget.Latest,true);
+  const declaration=source.statements.filter(ts.isVariableStatement)
+    .flatMap(s=>Array.from(s.declarationList.declarations))
+    .find(d=>d.name.getText(source)==='mutations');
+  assert.ok(declaration && ts.isArrayLiteralExpression(declaration.initializer));
+  const field=(node,key)=>node.properties.find(p=>p.name?.getText(source)===key)?.initializer?.text;
+  const item=declaration.initializer.elements.find(e=>field(e,'id')==='M6');
+  assert.ok(item,'M6 must remain present');
+  return {find:field(item,'find'),replace:field(item,'replace')};
+}
+module.exports={getM6};
+
+if (require.main===module) test('committed M6 replacement is executable SQL, not a syntax-error mutant',async()=>{
+  assert.equal(process.env.EASY_LEARN_TEST_DATABASE,'true');
+  const url=new URL(process.env.TEST_DATABASE_URL);
+  assert.ok(['127.0.0.1','localhost','[::1]'].includes(url.hostname));
+  const mutation=getM6();
+  assert.ok(mutation.replace.includes('${fileRef}'));
+  assert.ok(!mutation.replace.includes('${schoolId}'),'the intended guard must actually be removed');
+  const client=new Client({connectionString:url.toString()});
+  await client.connect();
+  try {
+    await client.query('CREATE TEMP TABLE uploaded_files (id uuid, school_id uuid)');
+    const id=crypto.randomUUID();
+    await client.query('INSERT INTO uploaded_files VALUES ($1,$2)',[id,crypto.randomUUID()]);
+    const expression=mutation.replace.replaceAll('${fileRef}','$1::uuid');
+    // Positive control: the same guard removal with a SQL comment is executable.
+    const control=await client.query(`SELECT (${expression.replace('// MUTANT M6:','-- MUTANT M6:')}) AS matched`,[id]);
+    assert.equal(control.rows[0].matched,true);
+    const result=await client.query(`SELECT (${expression}) AS matched`,[id]);
+    assert.equal(result.rows[0].matched,true);
+  } finally {await client.end();}
+});
